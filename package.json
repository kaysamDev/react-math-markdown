{
    "name": "react-math-markdown",
    "version": "1.0.0",
    "description": "Unified Markdown + LaTeX rendering component and Markdown ↔ Draft.js conversion utilities for React",
    "type": "module",
    "main": "./dist/react-math-markdown.cjs.js",
    "module": "./dist/react-math-markdown.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/react-math-markdown.es.js",
            "require": "./dist/react-math-markdown.cjs.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "demo": "vite --config vite.demo.config.ts",
        "build": "tsc --noEmit && vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src --ext .ts,.tsx",
        "format": "prettier --write \"src/**/*.{ts,tsx}\""
    },
    "peerDependencies": {
        "draft-js": ">=0.11.0",
        "katex": ">=0.16.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "peerDependenciesMeta": {
        "draft-js": {
            "optional": true
        },
        "katex": {
            "optional": true
        }
    },
    "dependencies": {
        "react-markdown": "^9.0.0",
        "rehype-katex": "^7.0.0",
        "remark-gfm": "^4.0.0",
        "remark-math": "^6.0.0"
    },
    "devDependencies": {
        "@types/draft-js": "^0.11.18",
        "@types/node": "^25.3.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "@vitejs/plugin-react": "^4.2.0",
        "draft-js": "^0.11.7",
        "eslint": "^8.56.0",
        "immutable": "^4.3.0",
        "jsdom": "^24.0.0",
        "katex": "^0.16.9",
        "prettier": "^3.2.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vite-plugin-dts": "^3.7.0",
        "vitest": "^1.2.0"
    },
    "keywords": [
        "react",
        "markdown",
        "latex",
        "math",
        "katex",
        "draft-js",
        "editor"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/kaysamDev/react-math-markdown"
    },
    "homepage": "https://www.npmjs.com/package/react-math-markdown",
    "author": "Samuel B. (kaysam)",
    "bugs": {
        "url": "https://github.com/kaysamDev/react-math-markdown/issues"
    }
}